# ========================================================
# Cloud-Based Student Information Chatbot (CSIC) Environment
# Copy this file to .env and populate with your credentials.
# NEVER commit your real .env file to version control.
# ========================================================

# Application Mode: development, staging, production
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://csic-orpin.vercel.app,https://csic-portal.vercel.app

# Database (Supabase PostgreSQL, Cloud PostgreSQL, or Local SQLite)
# If omitted or left blank in development, CSIC automatically uses local SQLite (database/csic.db).
# In production, a valid PostgreSQL DATABASE_URL is strictly required.
# 
# Supabase provides 3 connection string options in Dashboard -> Project Settings -> Database -> Connection String:
# 1. Transaction Pooler (Port 6543, recommended for Render/FastAPI):
#    DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# 2. Session Pooler (Port 5432 via pooler):
#    DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# 3. Direct Connection (Port 5432, requires IPv6):
#    DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=


# Supabase Auth & Storage
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
JWT_SECRET=your-supabase-jwt-secret-or-custom-secret

# Google Gemini API (for AI Chatbot and Document RAG)
# If left blank, the backend falls back to deterministic simulation mode
GEMINI_API_KEY=your-gemini-api-key

# Frontend Configuration (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://yourprojectref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
